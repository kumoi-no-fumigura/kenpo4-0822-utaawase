  },
  {
   "seq": "18",
   "text": "けさみれはかりの涙をふりませて時雨にのころ峯のもみち葉",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "秋風もゆふへやさむく成ぬらんうちもすさまぬあさのさ衣",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "うちわたるたけたの原の夕嵐にまなくもひゝく槌の音哉",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夜をさむみかつ置霜やまさるらむくるゝよりうつあさのさ衣",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "くるゝより夜さむの露もうちしほれ月になれゆく麻のさ衣",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "はるかなる雲よりをちの夕まくれかせにつけてそ衣打なる",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "ゆふ日さすおかへの庵にたれすみて秋きにけらし衣うつ覽",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "夕つくひさすやをかへの松のはのかせさむけくも衣うつ也",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "夕くれはたか秋風を身にしめて夜さむの衣ひとりうつらん",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "あけゆけは音もまとをに打絕し麻のさ衣くれをまちけり",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "ことゝはて夕きりかくれすむ人も里をはしれと衣うつをと",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "たか里の雲井に人をへたてつゝけふもくれぬと衣うつらん",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "聲さむみ夕風ふけは我せこかうらめつらしく衣うつ也",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "遠近のきぬたはそことわかねともおなしゝるへの秋の夕風",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "種かせの袖にすゝしきいさよひの月待ほともうつ衣哉",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "夕風のふきくるまゝに淋しきにいたくなうちそ賤のさころも",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "わするなよいもかきなれしから衣たつたの山の秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "賤のめか秋の狹衣うつたへにけふもくれぬとこゑいそくらん",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "うつとてもひとりはつらき夕くれを誰ためとしも衣うつらん",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "槇のはのつれなき色もなかりけり秋の深山の夕霧のそら",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "霧ふかき深山のおくにたつ鹿のみちやまとへる聲そ聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "こゑくるゝ山路も深き霧のうちにをとつれて行秋のたひ人",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "をはつせや峯のひ原に露おちて夕きりなひく秋の山かせ",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "いつくとか□くひもわけむ山深み夕きりまよふ道のなかてに",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "吹かせの千種の色もおのつから露のたえまのみ山へのおく",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "友よはふ遠こち人の聲すなの今朝たちこむる霧の中やま",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "朝きりのたつたの山を秋ゆけはそても草葉もおなし白露",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "きりふかきねやまををしむ鹿は猶おのれ鳴てや夜をのこす覽",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "卷向の檜はらか末はそれなから霧にあけ行峯の月影",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "たか袖にわけてみるちむ葛城のたかまの奥の夕霧の空",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "みよし野や槇たつ山の山人のおもひもいれぬそての秋きり",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "やまのはもあはれも深き夕霧に心そらなるむかしをそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "まきのたつあとも小倉の山深みたつきもしらぬ霧こめてけり",
   "kana": "",
   "speaker": "",
   "page": 236,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "たつねいる山路もふかき夕霧に鹿の音さへに遠さかりぬる",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "み山へやはれぬなかめもまさるらん雲よりおくの宿の朝きり",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "山人もおのれしほれて歸るらむたつたのおくのきりの迷ひに",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "すきわひぬ嶺の朝きりいくへともしらぬ庵のあとの山風",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "かきりあれはおなし都の雲たにもへたてゝ遠き心ならひを",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "契こし程は雲井の夜半の月おなしかたみの空をわするな",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "道すから都をこふる袖の上に淚とおつるこしのしら雪",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "小篠原かりねの床の山風に一夜の契夢をたえつゝ",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "しるといへは草の枕のかりにたにいはてそあかす露はをけ共",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "旅のそらふしの煙をなかめてもするかたもなき我身也けり",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "旅ころもきつゝかれ行古〓の悌のみそ袖にのこれる",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "たひ衣あきのわかれの袖の露さるは夜さむの床の山風",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "都をはぬれても出す旅ころもいく朝露の色かはるまて",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "思ひねの草の枕のゆめちにもわすれすのこる人の面影",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "かへりみるそなたのそらも白雲のかさなる峯に消つゝそ行",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "をのつから空ゆく月はめくりきぬ程は雲井の夕たつねて",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "しのひあまる心の色をゝきまよひ草の枕の露となしつる",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "我そてよしのたの杜にくらふれは千枝の雫もぬるゝ數かは",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "草まくらむすふかひには大方のならひにあまる袖のしら露",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "旅衣くちやはてなん夏引のいとしも物をおもふなみたに",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "東路の忍ふはしめの關の名をこえても猶そすゑの松山",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "玉鉾の道の草葉のかり枕露をかたみにいくよむすひつ",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "消かへりうはの空なる煙たにことうらかせはいふかひもなし",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "かみしまやいそまの浦の月みてもねぬよの浪そ袖にかさなる",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "くちねたゝかたみの浦の忘れ貝わすれぬものをあふよしも哉",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "はりま潟あまのかるもの我からや人に知られぬ身をくたく覽",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "わひぬれは袖ほすひまも遑なみ鹽くむ蜑の名にやふりなん",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "しるへせよわれもなくさの濵千鳥あとなき浪のよるの通路",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "鹽たれしはしめはことの數ならて蜑のもしほ火またこかる覽",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "我こひはみるめもしらす伊勢島やしほひの方は風もつれなし",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "いかにせむ思ひあかしの浦はより消かへりぬるあまのも鹽火",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "いせの海のあまのたくなは暮るゝ夜の長き思ひは秋そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "もらすなよ袂に浪はかよふともあまたにつゝむ戀の行衞を",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "をのつからありしばかりの夢も見す猶うしまとのせとの鹽風",
   "kana": "",
   "speaker": "",
   "page": 237,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "たちそひしつらきかたみも增鏡みぬめの浦に絕やはてぬる",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "よをたえて波にうきねをすまの蜑のかくやは袖の乾く時なき",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "あふ事を猶まつ島のあまころもしほたれてのみ年やふりなむ",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "思ひやるさかひやいつこ白浪のうちよる〓〓の夢をたにみす",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "わすれなん思はしとすれはいとゝ又すまの關やの秋かせの聲",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "いたつらに幾夜あかしのうら波にしほくむ蜑の獨ぬるらむ",
   "kana": "",
   "speaker": "",
   "page": 238,
