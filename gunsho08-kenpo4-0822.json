 "poems": [
  {
   "seq": "1",
   "text": "秋の色もまた朝露のをきそめて日影ことなる峯のもみちは",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "朝日かけさすや岡へのうす紅葉ひとしほならす色やそふらむ",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "色そこきまた露おちぬもみち葉はぬれて朝日のさすや岡へに",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "立田山しくれも夜半に過にけり淺茅のもみち色〓とになる",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "よこ雲はあけはなれゆく山のはにのこる紅葉も秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "夜もすから時雨ふりけり柞原しつくもかはる杜の下草",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "三室山もみちそめたる朝露のたえすかつちる嶺の秋かせ",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "柴の戶をあくるあさけの山のはに木葉うつろふ秋のむら雨",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あさな〓〓時雨の露に色そひて秋あらはなる神なひのもり",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "かくれぬのはつせの山のこもりえに朝露かけて移るもみちは",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "たつた山おなし梢の秋の色をもるゝひかりや朝日成らむ",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
